---
import '../styles/global.css';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageOrigin = import.meta.env.PORTFOLIO_PREVIEW === 'true'
  ? 'https://resume-preview.qdwct4w2sm.workers.dev'
  : Astro.site;
const shareImage = new URL('/images/social-card.png', imageOrigin);
const shareImageAlt = 'Kraig Spear. iOS Engineer. Made for real life. Thoughtful apps for Apple platforms. kraigspear.net.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {(!import.meta.env.PROD || import.meta.env.PORTFOLIO_PREVIEW === 'true') && <meta name="robots" content="noindex, nofollow" />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Kraig Spear" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-label="Kraig Spear, home">Kraig Spear<span aria-hidden="true">.</span></a>
      <nav aria-label="Main navigation">
        <a href="/#work">Work</a>
        <a href="/resume/">Resume</a>
        <a href="/#about">About</a>
        <a href="mailto:kraigspear@gmail.com">Get in touch <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer wrap"><p>Kraig Spear <span>· iOS Engineer</span></p><div class="footer-links"><a href="/projects/">More projects</a><a href="/open-source-contributions/">Open source &amp; patents</a><a href="https://github.com/kraigspear">GitHub <span aria-hidden="true">↗</span></a></div></footer>
  </body>
</html>
